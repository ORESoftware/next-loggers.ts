{
  "name": "@oresoftware/next-loggers",
  "version": "0.1.0",
  "description": "Runtime-aware ESM loggers for Next.js, browsers, Node.js, Bun, Deno, and edge workers",
  "type": "module",
  "types": "./dist/base-logger.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "edge-light": {
        "types": "./dist/edge-logger.d.ts",
        "default": "./dist/edge-logger.js"
      },
      "workerd": {
        "types": "./dist/edge-logger.d.ts",
        "default": "./dist/edge-logger.js"
      },
      "worker": {
        "types": "./dist/edge-logger.d.ts",
        "default": "./dist/edge-logger.js"
      },
      "browser": {
        "types": "./dist/browser-logger.d.ts",
        "default": "./dist/browser-logger.js"
      },
      "deno": {
        "types": "./dist/deno-logger.d.ts",
        "default": "./dist/deno-logger.js"
      },
      "bun": {
        "types": "./dist/bun-logger.d.ts",
        "default": "./dist/bun-logger.js"
      },
      "node": {
        "types": "./dist/node-logger.d.ts",
        "default": "./dist/node-logger.js"
      },
      "types": "./dist/base-logger.d.ts",
      "import": "./dist/base-logger.js",
      "default": "./dist/base-logger.js"
    },
    "./base": {
      "types": "./dist/base-logger.d.ts",
      "default": "./dist/base-logger.js"
    },
    "./browser": {
      "types": "./dist/browser-logger.d.ts",
      "default": "./dist/browser-logger.js"
    },
    "./edge": {
      "types": "./dist/edge-logger.d.ts",
      "default": "./dist/edge-logger.js"
    },
    "./node": {
      "types": "./dist/node-logger.d.ts",
      "default": "./dist/node-logger.js"
    },
    "./bun": {
      "types": "./dist/bun-logger.d.ts",
      "default": "./dist/bun-logger.js"
    },
    "./deno": {
      "types": "./dist/deno-logger.d.ts",
      "default": "./dist/deno-logger.js"
    },
    "./context": {
      "browser": {
        "types": "./dist/context-browser.d.ts",
        "default": "./dist/context-browser.js"
      },
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./eslint": {
      "types": "./dist/eslint-plugin.d.ts",
      "default": "./dist/eslint-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build && tsc -p tests/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORESoftware/next-loggers.ts.git"
  },
  "homepage": "https://github.com/ORESoftware/next-loggers.ts#readme",
  "bugs": {
    "url": "https://github.com/ORESoftware/next-loggers.ts/issues"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "keywords": [
    "logging",
    "nextjs",
    "esm",
    "supabase",
    "bun",
    "deno",
    "edge"
  ],
  "license": "MIT"
}
